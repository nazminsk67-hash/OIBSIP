# ── Server ──────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ──────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/pizza-delivery

# ── JWT ──────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d

# ── Production SMTP (delivers to real inboxes) ───────────────────
# DO NOT use sandbox.smtp.mailtrap.io — it does not deliver to Gmail/Outlook.
#
# Option A — Gmail (use App Password: https://myaccount.google.com/apppasswords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.email@gmail.com
# SMTP_PASS=your_16_char_app_password
# EMAIL_FROM="PizzaHub <your.email@gmail.com>"
#
# Option B — Mailtrap Email Sending (NOT Sandbox)
# SMTP_HOST=live.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=your_mailtrap_sending_username
# SMTP_PASS=your_mailtrap_sending_password
# EMAIL_FROM="PizzaHub <hello@yourdomain.com>"
#
# Option C — SendGrid
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key
# EMAIL_FROM="PizzaHub <noreply@yourdomain.com>"

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="PizzaHub <your.email@gmail.com>"
# Set true only for port 465
# SMTP_SECURE=false

# ── Client URL (for email verification & reset links) ────────────
CLIENT_URL=http://localhost:5173

# ── Admin Email (low-stock alert recipient) ───────────────────────
ADMIN_EMAIL=admin@pizzadelivery.com

# ── Razorpay ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ── Inventory thresholds (units) ─────────────────────────────────
STOCK_ALERT_THRESHOLD=20
